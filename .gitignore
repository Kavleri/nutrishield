# ==============================================================================
# NutriShield Repository - Comprehensive .gitignore
# ==============================================================================

# Node / Frontend dependencies & build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js build outputs
.next/
out/
build/
dist/
.turbo/

# Python / Backend cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml

# Databases & Local state
*.db-journal
*.db-wal
*.db-shm
*.sqlite3-journal
*.local.db
local_runtime/

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx
secrets/

# IDE & Operating System files
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs and runtime artifacts
logs/
*.log
*.pid
*.seed
*.pid.lock
generated_reports/*.pdf
!generated_reports/.gitkeep
tmp/
temp/
